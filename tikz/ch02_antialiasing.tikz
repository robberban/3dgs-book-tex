\begin{tikzpicture}[
  route/.style={rectangle, rounded corners=5pt, draw=#1, fill=#1!10,
    text width=3.2cm, minimum height=0.9cm, align=center, font=\small},
  method/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!6,
    font=\scriptsize, text width=3.0cm, align=center, minimum height=0.6cm},
  arr/.style={-{Stealth[length=4pt]}, techgray!60},
  >=Stealth
]

  \node[route=techgray, text width=4cm, font=\small\bfseries] (root) at (25.7, 5.6) {抗锯齿方法};
  \node[route=techblue] (b0) at (9.3, 3.1) {频率约束路线};
  \node[method=techblue] (b0_l0) at (3.0, 0.6) {3D平滑+2D Mip滤波\\{\tiny Mip-Splatting, AAA-Gaussians}};
  \node[method=techblue] (b0_l1) at (9.3, 0.6) {可学习滤波强度映射\\{\tiny LOD-GS}};
  \node[route=techgreen] (b1) at (22.3, 3.1) {多尺度表示路线};
  \node[method=techgreen] (b1_l0) at (15.3, 0.6) {多尺度高斯层次结构\\{\tiny MS-GS}};
  \node[method=techgreen] (b1_l1) at (22.3, 0.6) {基元自变形/尺度一致性引导\\{\tiny Mipmap-GS}};
  \node[route=techorange] (b2) at (29.1, 3.1) {屏幕空间路线};
  \node[method=techorange] (b2_l0) at (29.1, 0.6) {空间分布Alpha混合\\{\tiny Gaussian Blending}};
  \node[method=techorange] (b2_l1) at (35.0, 0.6) {2D高斯专用抗锯齿\\{\tiny AA-2DGS, MSAA+约束优化}};
  \node[route=techpurple] (b3) at (37.8, 3.1) {免训练路线};
  \node[method=techpurple] (b3_l0) at (42.2, 0.6) {测试时尺度自适应，无需重训练\\{\tiny SA-GS}};
  \draw[arr] (root) -- (b0);
  \draw[arr] (root) -- (b1);
  \draw[arr] (root) -- (b2);
  \draw[arr] (root) -- (b3);
  \draw[arr] (b0) -- (b0_l0);
  \draw[arr] (b0) -- (b0_l1);
  \draw[arr] (b1) -- (b1_l0);
  \draw[arr] (b1) -- (b1_l1);
  \draw[arr] (b2) -- (b2_l0);
  \draw[arr] (b2) -- (b2_l1);
  \draw[arr] (b3) -- (b3_l0);
  \node[draw=techgray, fill=techgray!5, rounded corners, font=\scriptsize,
    text width=12cm, align=center] at (23.6, -1.2) {核心问题：固定尺寸高斯在采样率变化时产生锯齿和膨胀/侵蚀伪影。各路线分别从频率约束、多尺度表示、屏幕空间积分和测试时适配四个角度解决此问题。};
\end{tikzpicture}