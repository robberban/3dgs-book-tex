  \node[method=techorange] (b2_l0) at (15.9, 0.6) {动静分解\\{\tiny Street Gaussians, DynaGS-Drive}};
  \node[method=techorange] (b2_l1) at (19.5, 0.6) {综合动态\\{\tiny 4DGS-Drive, OmniRe, PVG}};
  \node[route=techpurple] (b3) at (23.6, 3.1) {传感器融合};
  \node[method=techpurple] (b3_l0) at (23.6, 0.6) {多传感器融合\\{\tiny LiDAR-GS-Drive, RadarGS}};
  \node[method=techpurple] (b3_l1) at (27.3, 0.6) {定位\\{\tiny GeomGS, LocGS, PoseGS}};
  \node[route=techblue] (b4) at (30.9, 3.1) {3D占用与感知};
  \node[method=techblue] (b4_l0) at (30.9, 0.6) {高斯辅助感知\\{\tiny OccGS, GaussianOcc, GS-Perc}};
  \node[method=techblue] (b4_l1) at (35.0, 0.6) {占用估计\\{\tiny OccSplat, GSOcc}};
