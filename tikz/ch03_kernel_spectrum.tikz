\begin{tikzpicture}[
  route/.style={rectangle, rounded corners=5pt, draw=#1, fill=#1!10,
    text width=3.2cm, minimum height=0.9cm, align=center, font=\small},
  method/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!6,
    font=\scriptsize, text width=3.0cm, align=center, minimum height=0.6cm},
  arr/.style={-{Stealth[length=4pt]}, techgray!60},
  >=Stealth
]

  \node[route=techgray, text width=4cm, font=\small\bfseries] (root) at (27.6, 5.6) {高斯核};
  \node[route=techorange] (b0) at (10.2, 3.1) {有界化};
  \node[method=techorange] (b0_l0) at (2.1, 0.6) {线性Splatting};
  \node[method=techorange] (b0_l1) at (7.5, 0.6) {Beta核 DBS,UBS};
  \node[method=techorange] (b0_l2) at (12.9, 0.6) {Student-t SSS};
  \node[route=techgreen] (b1) at (24.3, 3.1) {非对称化};
  \node[method=techgreen] (b1_l0) at (18.1, 0.6) {半高斯 3D-HGS};
  \node[method=techgreen] (b1_l1) at (24.3, 0.6) {偏斜正态 Skew-Normal};
  \node[route=techpurple] (b2) at (31.0, 3.1) {多边形化};
  \node[method=techpurple] (b2_l0) at (31.0, 0.6) {凸包Splatting 3DCS};
  \node[method=techpurple] (b2_l1) at (38.0, 0.6) {三角形Splatting TriSplat};
  \node[route=techorange] (b3) at (48.1, 3.1) {理论推广};
  \node[method=techorange] (b3_l0) at (44.8, 0.6) {通用径向基 DARBF};
  \node[method=techorange] (b3_l1) at (51.3, 0.6) {多项式核 Poly Kernels};
  \node[method=techorange] (b3_l2) at (57.9, 0.6) {非指数衰减 Non-exp};
  \draw[arr] (root) -- (b0);
  \draw[arr] (root) -- (b1);
  \draw[arr] (root) -- (b2);
  \draw[arr] (root) -- (b3);
  \draw[arr] (b0) -- (b0_l0);
  \draw[arr] (b0) -- (b0_l1);
  \draw[arr] (b0) -- (b0_l2);
  \draw[arr] (b1) -- (b1_l0);
  \draw[arr] (b1) -- (b1_l1);
  \draw[arr] (b2) -- (b2_l0);
  \draw[arr] (b2) -- (b2_l1);
  \draw[arr] (b3) -- (b3_l0);
  \draw[arr] (b3) -- (b3_l1);
  \draw[arr] (b3) -- (b3_l2);
\end{tikzpicture}