\begin{tikzpicture}[
  box/.style={rectangle, rounded corners=4pt, draw=#1, fill=#1!10,
    text width=3.5cm, align=center, font=\small, minimum height=0.75cm},
  diam/.style={diamond, draw=#1, fill=#1!8, font=\scriptsize,
    text width=1.8cm, align=center, aspect=2},
  biglabel/.style={font=\bfseries\small, #1},
  arr/.style={-{Stealth[length=5pt]}, thick, #1},
  >=Stealth
]

  \node[biglabel=techblue] at (3.7, 7.7) {原始 ADC};
  \node[biglabel=techgreen] at (7.5, 5.2) {ResGS 残差分裂};
  \draw[thick, techgray, dashed] (-0.1, 3.7) -- (15.2, 3.7);
  \node[box=techblue] (orig) at (3.5, 6.2) {待致密化高斯};
  \node[diam=techblue] (judge) at (3.5, 3.7) {尺度 $< S_T$?};
  \node[box=techblue] (clone) at (1.9, 1.2) {Clone\\复制到相同位置};
  \node[box=techblue] (split) at (5.5, 1.2) {Split\\二分为子高斯};
  \node[box=techgreen] (rorig) at (11.3, 6.2) {待致密化高斯};
  \node[box=techgreen] (parent) at (8.9, 3.7) {\textbf{父高斯}\\（保持原尺度）};
  \node[box=techorange] (child) at (13.2, 3.7) {\textbf{残差子高斯}\\（缩放补充细节）};
  \draw[arr=techblue] (orig) -- (judge);
  \draw[arr=techblue] (judge) -- node[above, font=\scriptsize] {是} (clone);
  \draw[arr=techblue] (judge) -- node[above, font=\scriptsize] {否} (split);
  \draw[arr=techgreen] (rorig) -- (parent);
  \draw[arr=techorange] (rorig) -- (child);
  \node[draw=techgray, fill=techbg, rounded corners, font=\scriptsize, text width=9cm, align=center]
    at (11.0, 1.9) {
    \textbf{非对称设计消除互斥选择}：父高斯保持原有尺度扩展空间覆盖，子高斯以更细粒度补充局部细节。
  };
\end{tikzpicture}