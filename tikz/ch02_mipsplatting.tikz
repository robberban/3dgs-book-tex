\begin{tikzpicture}[
  box/.style={rectangle, rounded corners=4pt, draw=#1, fill=#1!10, text width=3cm, align=center, font=\small, minimum height=0.75cm},
  widebox/.style={rectangle, rounded corners=4pt, draw=#1, fill=#1!10, text width=3.5cm, align=center, font=\small, minimum height=0.75cm},
  diam/.style={diamond, draw=#1, fill=#1!8, font=\scriptsize, text width=1.8cm, align=center, aspect=2},
  biglabel/.style={font=\bfseries\small, #1},
  arr/.style={-{Stealth[length=5pt]}, thick, #1},
  >=Stealth
]
  \node[biglabel=techblue] (o_title) at (1.5, 10.6) {\textbf{原始 3DGS}};
  \node[box=techblue] (o1) at (5.7, 10.6) {3D 高斯基元};
  \node[box=techblue] (o2) at (5.7, 8.1) {投影到 2D};
  \node[box=techblue] (o3) at (5.7, 5.6) {固定膨胀\\（$\sigma_l \approx 0.3$ 像素）};
  \node[box=techblue] (o4) at (5.7, 3.1) {Tile 光栅化\\$\alpha$-混合渲染};
  \node[box=techblue] (o5) at (5.7, 0.6) {像素颜色};
  \node[biglabel=techgreen] (m_title) at (10.6, 10.6) {\textbf{Mip-Splatting}};
  \node[box=techgreen] (m1) at (15.5, 10.6) {3D 高斯基元};
  \node[box=techgreen, draw=techorange, fill=techorange!10] (m2) at (15.5, 8.1) {\textbf{3D 平滑滤波器}\\约束频率上界（训练时）};
  \node[box=techgreen] (m3) at (15.5, 5.6) {投影到 2D};
  \node[box=techgreen, draw=techorange, fill=techorange!10] (m4) at (15.5, 3.1) {\textbf{2D Mip 滤波器}\\模拟像素积分（渲染时）};
  \node[box=techgreen] (m5) at (15.5, 0.6) {像素颜色};
  \draw[arr=techblue] (o1) -- (o2);
  \draw[arr=techblue] (o2) -- (o3);
  \draw[arr=techblue] (o3) -- (o4);
  \draw[arr=techblue] (o4) -- (o5);
  \draw[arr=techgreen] (m1) -- (m2);
  \draw[arr=techgreen] (m2) -- (m3);
  \draw[arr=techgreen] (m3) -- (m4);
  \draw[arr=techgreen] (m4) -- (m5);
  \node[draw=techgray, fill=techbg, rounded corners, font=\scriptsize, text width=9cm, align=center] at (9.8, -1.9) {
    两个滤波器协同工作：3D 滤波器消除\textbf{放大}时的高频伪影，
    2D Mip 滤波器消除\textbf{缩小}时的锯齿。
    实验：Mip-NeRF360 上 $2\times$ 缩放测试 PSNR 比原始 3DGS 高 2--5 dB。
  };
\end{tikzpicture}